rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public cursor catalog. Anyone can view cursor content;
    // only authenticated admins can create, edit, or delete it.
    match /cursors/{cursorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin documents are checked by UID. Create/update/delete these
    // documents from the Firebase Console, not from the website.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }
  }
}
